-- 1. Shipment Search & Filter Stored Procedure
IF OBJECT_ID('dbo.sp_SearchShipments', 'P') IS NOT NULL DROP PROCEDURE dbo.sp_SearchShipments;
GO

CREATE PROCEDURE dbo.sp_SearchShipments
    @ExporterID INT = NULL,
    @ClientID INT = NULL,
    @DestinationTerminalID INT = NULL,
    @ShipmentStatus VARCHAR(50) = NULL,
    @StartDate DATE = NULL,
    @EndDate DATE = NULL
AS
BEGIN
    SET NOCOUNT ON;

    SELECT 
        s.ShipmentID,
        s.ShipmentReference,
        e.CompanyName AS ExporterName,
        c.CompanyName AS ClientName,
        t.TerminalName AS DestinationTerminal,
        s.ShipmentDate,
        s.EstimatedDeliveryDate,
        s.TransportMethod,
        s.ShipmentStatus
    FROM dbo.Shipment s
    INNER JOIN dbo.Exporter e ON s.ExporterID = e.ExporterID
    INNER JOIN dbo.Client c ON s.ClientID = c.ClientID
    INNER JOIN dbo.Terminal t ON s.DestinationTerminalID = t.TerminalID
    WHERE (@ExporterID IS NULL OR s.ExporterID = @ExporterID)
      AND (@ClientID IS NULL OR s.ClientID = @ClientID)
      AND (@DestinationTerminalID IS NULL OR s.DestinationTerminalID = @DestinationTerminalID)
      AND (@ShipmentStatus IS NULL OR s.ShipmentStatus = @ShipmentStatus)
      AND (@StartDate IS NULL OR s.ShipmentDate >= @StartDate)
      AND (@EndDate IS NULL OR s.ShipmentDate <= @EndDate);
END;
GO

-- 2. Shipment Tracking History View
IF OBJECT_ID('dbo.vw_ShipmentTrackingSummary', 'V') IS NOT NULL DROP VIEW dbo.vw_ShipmentTrackingSummary;
GO

CREATE VIEW dbo.vw_ShipmentTrackingSummary AS
SELECT 
    s.ShipmentReference,
    e.CompanyName AS Exporter,
    c.CompanyName AS Consignee,
    st.Status AS CurrentStage,
    st.Location,
    st.Remarks,
    st.RecordedAt
FROM dbo.ShipmentTracking st
INNER JOIN dbo.Shipment s ON st.ShipmentID = s.ShipmentID
INNER JOIN dbo.Exporter e ON s.ExporterID = e.ExporterID
INNER JOIN dbo.Client c ON s.ClientID = c.ClientID;
GO
